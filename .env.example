# Database path (SQLite)
RESY_SNIPER_DB=sqlite:///./resy_sniper.db

# Discovery/inference settings
DEFAULT_CITY=NYC
REDDIT_USER_AGENT=resy-sniper/0.1
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_RATE_LIMIT_SECONDS=2

# Provider credentials (official partner APIs typically require onboarding)
RESY_API_KEY=
RESY_API_BASE_URL=
OPENTABLE_API_KEY=
OPENTABLE_API_BASE_URL=

# Scoring knobs
WEIGHT_SEED_BONUS=0.5
WEIGHT_REDDIT_MATCH=0.3
WEIGHT_EXPLICIT_PATTERN=0.3
WEIGHT_RECENCY_BOOST=0.2
WEIGHT_EXTERNAL_SIGNALS=0.1

# Booking settings
BOOKING_REFRESH_SECONDS=5
BOOKING_JITTER_SECONDS=2
PROFILE_STORAGE_ENABLED=true
